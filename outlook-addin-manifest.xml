<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MailApp">

  <!-- Sostituire {NETLIFY_DOMAIN} con il dominio reale es. tweppy-gds.netlify.app -->

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>1.0.0</Version>
  <ProviderName>Studio GDS</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>
  <DisplayName DefaultValue="GDS Studio CRM"/>
  <Description DefaultValue="Identifica il mittente nel CRM, mostra i task attivi e permette di creare nuovi task direttamente da Outlook."/>
  <IconUrl DefaultValue="https://{NETLIFY_DOMAIN}/favicon.ico"/>
  <HighResolutionIconUrl DefaultValue="https://{NETLIFY_DOMAIN}/favicon.ico"/>
  <SupportUrl DefaultValue="https://{NETLIFY_DOMAIN}"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="MailBox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://{NETLIFY_DOMAIN}/outlook"/>
        <RequestedHeight>300</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

</OfficeApp>
